BOT_TOKEN=123456:telegram-bot-token
BOT_MODE=polling
WEBHOOK_BASE_URL=https://example.com
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=change-me
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_BIND=127.0.0.1
WEB_SERVER_PORT=8080

DATABASE_URL=postgresql+asyncpg://price_alerts:change-me@postgres.example.com:5432/price_alerts
REDIS_URL=redis://redis.example.com:6379/0
POSTGRES_DB=price_alerts
POSTGRES_USER=price_alerts
POSTGRES_PASSWORD=change-me
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
REDIS_BIND=127.0.0.1
REDIS_PORT=6379

PRICE_REFRESH_INTERVAL_SECONDS=45
PROVIDER_TIMEOUT_SECONDS=10
PROVIDER_MAX_ATTEMPTS=3
NFT_REFRESH_INTERVAL_SECONDS=300
SEARCH_CACHE_SECONDS=120

# Client-side budgets kept below the published provider limits. See docs/provider-rate-limits.md.
CCXT_REQUESTS_PER_MINUTE=600
CCXT_MARKETS_TTL_SECONDS=3600
DEXSCREENER_REQUESTS_PER_MINUTE=240
HYPERLIQUID_REQUESTS_PER_MINUTE=40
OPENSEA_READS_PER_HOUR=540
NOTIFICATION_MAX_ATTEMPTS=5

# Keep registration private until launch. Set true to activate new and pending users when they send /start.
PUBLIC_ACCESS_ENABLED=false

# Admins can always use these. Keep false while Trenchbook and custom webhook delivery are private.
PUBLIC_INTEGRATIONS_ENABLED=false
PUBLIC_CUSTOM_WEBHOOKS_ENABLED=false

RESERVOIR_BASE_URL=https://api.reservoir.tools
RESERVOIR_API_KEY=

NFT_PROVIDERS=opensea
OPENSEA_BASE_URL=https://api.opensea.io
OPENSEA_API_KEY=
OPENSEA_CHAIN=ethereum

# Master key for encrypting integration secrets stored in Postgres.
# Generate once with: uv run price-alert-cli generate-integration-key
INTEGRATION_SECRETS_KEY=
