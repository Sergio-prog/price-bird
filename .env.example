BOT_TOKEN=123456:telegram-bot-token
BOT_MODE=polling
WEBHOOK_BASE_URL=https://example.com
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=change-me
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_BIND=127.0.0.1
WEB_SERVER_PORT=8080

DATABASE_URL=postgresql+asyncpg://price_alerts:change-me@postgres.example.com:5432/price_alerts
REDIS_URL=redis://redis.example.com:6379/0
POSTGRES_DB=price_alerts
POSTGRES_USER=price_alerts
POSTGRES_PASSWORD=change-me
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
REDIS_BIND=127.0.0.1
REDIS_PORT=6379

PRICE_REFRESH_INTERVAL_SECONDS=45
PROVIDER_TIMEOUT_SECONDS=10
PROVIDER_MAX_ATTEMPTS=3
NOTIFICATION_MAX_ATTEMPTS=5

RESERVOIR_BASE_URL=https://api.reservoir.tools
RESERVOIR_API_KEY=

NFT_PROVIDERS=opensea
OPENSEA_BASE_URL=https://api.opensea.io
OPENSEA_API_KEY=
OPENSEA_CHAIN=ethereum

# Master key for encrypting integration secrets stored in Postgres.
# Generate once with: uv run price-alert-cli generate-integration-key
INTEGRATION_SECRETS_KEY=
